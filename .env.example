# Copy this file to .env and fill in your values
# cp .env.example .env

# Speech-to-Text Provider: choose from 'faster-whisper', 'whisper', or 'openai'
STT_PROVIDER=faster-whisper

# OpenAI API key — required for cloud LLM calls
# Required only if STT_PROVIDER=openai
OPENAI_API_KEY=sk-...

# PostgreSQL credentials
# NOTE: the password is NOT set here — it comes from a Docker secret
# (./secrets/postgres_password.txt, injected as POSTGRES_PASSWORD_FILE).
# PostgreSQL — non-sensitive values only; the password lives in a Docker secret
# (POSTGRES_HOST isn't set here — docker-compose.yml hardcodes it to
# host.docker.internal; see CLAUDE.md's Key Design Patterns for why.)
POSTGRES_USER=postgres
POSTGRES_DB=vision_assist

# Vision engine (YOLO/YOLOE) — all optional, defaults shown.
# Switching engines at runtime is done from the UI toggle, not these vars —
# see docs/YOLO_VS_YOLOE_GUIDE.md. These only set the startup default and
# apply to anything outside the running app (scripts, tests).
# VISION_MODEL_TYPE=yolo
# YOLO_MODEL_PATH=
# FINE_TUNED_YOLO_MODEL_PATH=
# VISION_CUSTOM_CLASSES=


# ---------------------------------------------------------------------------
# Secrets (NOT stored here — create these files under ./secrets/, git-ignored)
#   secrets/postgres_password.txt  -> Postgres password (POSTGRES_PASSWORD_FILE)
#   secrets/qdrant_api_key.txt     -> Qdrant API key   (QDRANT__SERVICE__API_KEY)
# ---------------------------------------------------------------------------
