# Copy this file to .env and fill in your values
# cp .env.example .env

# Speech-to-Text Provider: choose from 'faster-whisper', 'whisper', or 'openai'
STT_PROVIDER=faster-whisper

# OpenAI API key — required for cloud LLM calls
# Required only if STT_PROVIDER=openai
OPENAI_API_KEY=sk-...

# PostgreSQL credentials
# NOTE: the password is NOT set here — it comes from a Docker secret
# (./secrets/postgres_password, injected as POSTGRES_PASSWORD_FILE).
# PostgreSQL — non-sensitive values only; the password lives in a Docker secret
POSTGRES_USER=postgres
POSTGRES_DB=vision_assist
# POSTGRES_HOST: the hostname backend uses to reach Postgres.
#   vision_assist_db        -> default; works on plain Docker/Docker Desktop
#                               (direct container-to-container bridge DNS)
#   host.docker.internal    -> use this instead in GitHub Codespaces — direct
#                               bridge routing was found broken there; routing
#                               through the host (extra_hosts: host-gateway in
#                               docker-compose.yml) works instead. See
#                               docs/TESTING_LOCAL_AND_CODESPACES.md.
POSTGRES_HOST=vision_assist_db


# ---------------------------------------------------------------------------
# Secrets (NOT stored here — create these files under ./secrets/, git-ignored)
#   secrets/postgres_password  -> Postgres password (POSTGRES_PASSWORD_FILE)
#   secrets/qdrant_api_key     -> Qdrant API key   (QDRANT__SERVICE__API_KEY)
# Save both as UTF-8, NO BOM, NO trailing newline (see README "Getting Started").
#   bash:       printf '%s' 'value' > secrets/postgres_password
#   PowerShell: [IO.File]::WriteAllText("$PWD\secrets\postgres_password", 'value')
# ---------------------------------------------------------------------------
